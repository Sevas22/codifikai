# Panel admin del blog (Supabase) — https://supabase.com/dashboard
# Proyecto > Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Generación de artículos con IA (Groq) — https://console.groq.com/keys
GROQ_API_KEY=
# Opcional: modelo de Groq a usar (default: llama-3.3-70b-versatile)
GROQ_MODEL=

# URL pública del sitio (para metadata/sitemap)
NEXT_PUBLIC_SITE_URL=

# Formulario de contacto (/contact) — envío de correo vía Resend
# https://resend.com/api-keys — SIN esto el formulario responde 503 y no llega ningún lead.
RESEND_API_KEY=
# Correo que recibe los leads del formulario (privado, no expuesto al cliente)
CONTACT_TO_EMAIL=
# Opcional: remitente del correo (default: onboarding@resend.dev, dominio no verificado de Resend)
CONTACT_FROM_EMAIL=

# Correo de contacto público mostrado en el sitio (CTAs, footer, error del formulario)
# Si se deja vacío cae a codifikai@gmail.com — define un correo de dominio propio.
NEXT_PUBLIC_CONTACT_EMAIL=

# Opcional: URL de Cal.com/Calendly para el calendario embebido de /contact.
# Si se deja vacío, esa sección muestra un CTA de WhatsApp en su lugar.
NEXT_PUBLIC_BOOKING_URL=

# Opcional: contenedor de Google Tag Manager. Si se deja vacío, se usa un ID
# de ejemplo hardcodeado en components/google-tag-manager.tsx — defínelo para
# apuntar al contenedor real de la cuenta de Google Ads/Analytics del negocio.
NEXT_PUBLIC_GTM_ID=

# Opcional: código de verificación de Google Search Console (meta tag).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Panel /admin/analytics — service account de Google Cloud con acceso a
# Search Console y/o Analytics 4 (ver guía en el README o pedir el paso a
# paso). Pega el JSON completo de la clave en una sola línea.
GOOGLE_SERVICE_ACCOUNT_KEY=
# Propiedad de Search Console tal cual aparece en el selector: para una
# propiedad de dominio es "sc-domain:codifikai.com"; para una de tipo URL
# es "https://www.codifikai.com/" (con barra final).
GOOGLE_SEARCH_CONSOLE_SITE_URL=
# ID numérico de la propiedad de GA4 (Administrador > Detalles de la propiedad).
GA4_PROPERTY_ID=
